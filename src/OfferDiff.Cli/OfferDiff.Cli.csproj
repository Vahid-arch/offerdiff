<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OfferDiff.Core\OfferDiff.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- the command is "offerdiff"; set here, not with -p:AssemblyName, which would rename OfferDiff.Core too -->
    <AssemblyName>offerdiff</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- no ICU needed, so the Linux binary runs on minimal systems; all parsing already uses invariant culture -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
